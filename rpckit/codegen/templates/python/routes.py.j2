{% for route in routes %}{{ route.method_member }}: RpcRouteInfo[{{ route | route_params }}, {{ route.result | annotation }}] = RpcRouteInfo(
    method={{ route.rpc_name | literal }},
    result_adapter=TypeAdapter({{ route.result | annotation }}),
{% if route.server is not none %}    server={{ route.server | literal }},
{% endif %})
{% if not loop.last or notifications %}
{% endif %}{% endfor %}{% for event in notifications %}{{ event.rpc_name | constant }}: RpcNotificationInfo[{{ event.payload | annotation }}] = RpcNotificationInfo(
    method={{ event.rpc_name | literal }},
    message_adapter=TypeAdapter({{ event.message | annotation }}),
    payload_adapter=TypeAdapter({{ event.payload | annotation }}),
{% if event.errors %}    error_mapper=error_from_response,
{% endif %}{% if event.server is not none %}    server={{ event.server | literal }},
{% endif %})
{% if not loop.last %}
{% endif %}{% endfor %}
